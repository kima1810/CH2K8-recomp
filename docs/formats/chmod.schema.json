{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kima1810/CH2K8-recomp/blob/ZMO-beta1/docs/formats/chmod.schema.json",
  "title": "CHMOD schema 1 / mod API 1.3 typed native extensions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "author",
    "version",
    "requires",
    "content",
    "capabilities",
    "dependencies",
    "incompatible",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/label"
    },
    "author": {
      "$ref": "#/$defs/label"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xex_sha256",
        "recomp",
        "mod_api"
      ],
      "properties": {
        "xex_sha256": {
          "$ref": "#/$defs/hash"
        },
        "recomp": {
          "const": "ZMO-beta1"
        },
        "mod_api": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ]
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "assets",
          "rosters",
          "code"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dds.replace",
          "cloth.positions",
          "roster.expose",
          "uniform.register",
          "hook.player.weight.read",
          "hook.player.weight.write",
          "lifecycle.runtime.ready",
          "lifecycle.runtime.stopping",
          "data.player.weight.read",
          "data.player.weight.pending_write",
          "hook.presentation.button_style",
          "court.scene",
          "cloth.simulation"
        ]
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "abi",
              "hook"
            ],
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 220,
                "pattern": "^code/[A-Za-z0-9_.-]+\\.dll$"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "abi": {
                "const": 1
              },
              "hook": {
                "const": "player.weight.read"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "sha256",
              "abi",
              "capabilities",
              "replacements"
            ],
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 220,
                "pattern": "^code/[A-Za-z0-9_.-]+\\.dll$"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "abi": {
                "const": 2
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "hook.player.weight.read",
                    "hook.player.weight.write",
                    "lifecycle.runtime.ready",
                    "lifecycle.runtime.stopping",
                    "data.player.weight.read",
                    "data.player.weight.pending_write",
                    "hook.presentation.button_style"
                  ]
                }
              },
              "replacements": {
                "type": "array",
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "player.weight.read",
                    "player.weight.write"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "uniforms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "template_hash",
          "template_layout_sha256",
          "folder",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:sel)?u[haxyz][0-9]{3,4}\\.iff$"
          },
          "template_hash": {
            "$ref": "#/$defs/u32"
          },
          "template_layout_sha256": {
            "$ref": "#/$defs/hash"
          },
          "folder": {
            "type": "string",
            "maxLength": 220,
            "pattern": "^uniforms/(?:sel)?u[haxyz][0-9]{3,4}\\.iff$"
          },
          "files": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 220,
                  "pattern": "^[A-Za-z0-9_./-]+$"
                },
                "sha256": {
                  "$ref": "#/$defs/hash"
                }
              }
            }
          }
        }
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "header",
        "header_sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 220,
          "pattern": "^rosters/.+\\.ROS$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "header": {
          "type": "string",
          "maxLength": 220,
          "pattern": "^rosters/.+\\.header$"
        },
        "header_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "incompatible": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "update_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases(?:/.*)?$"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bank_hash",
          "record_index",
          "record_id",
          "record_type",
          "target",
          "source_sha256",
          "file",
          "sha256"
        ],
        "properties": {
          "bank_hash": {
            "$ref": "#/$defs/u32"
          },
          "record_index": {
            "$ref": "#/$defs/u32"
          },
          "record_id": {
            "$ref": "#/$defs/u32"
          },
          "record_type": {
            "enum": [
              1547079785,
              3798768477,
              3776073491
            ]
          },
          "kind": {
            "enum": [
              "dds.replace",
              "cloth.positions",
              "court.scene",
              "cloth.simulation"
            ]
          },
          "component": {
            "enum": [
              0,
              1
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 220
          },
          "source_sha256": {
            "$ref": "#/$defs/hash"
          },
          "file": {
            "type": "string",
            "maxLength": 220
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "selection": {
            "const": "presentation.playstation",
            "description": "SDK Button Style conditional DDS. Requires the primary and stick atlases, with an optional navigation atlas."
          },
          "texture_slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "cloth.simulation"
                }
              }
            },
            "then": {
              "required": [
                "component"
              ],
              "properties": {
                "record_type": {
                  "const": 3776073491
                },
                "bank_hash": {
                  "const": 4198237405
                },
                "component": {
                  "const": 0
                },
                "target": {
                  "pattern": "^assets/cloth_shorts\\.iff/shorts(?:fat|reg|thin)\\.e1124f13/resource_data\\.dat$"
                },
                "file": {
                  "pattern": "^assets/.+\\.dat$"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "selection"
                    ]
                  },
                  {
                    "required": [
                      "texture_slot"
                    ]
                  }
                ]
              }
            },
            "else": {
              "if": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "cloth.positions"
                  }
                }
              },
              "then": {
                "required": [
                  "component"
                ],
                "properties": {
                  "record_type": {
                    "const": 3798768477
                  },
                  "target": {
                    "pattern": "^assets/[^/]+\\.iff/[^/]+\\.scne/(?:block0|scene)\\.dat$"
                  },
                  "file": {
                    "pattern": "^assets/.+\\.dat$"
                  },
                  "component": {
                    "const": 0
                  }
                }
              },
              "else": {
                "if": {
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "court.scene"
                    }
                  }
                },
                "then": {
                  "required": [
                    "component"
                  ],
                  "properties": {
                    "record_type": {
                      "const": 3798768477
                    },
                    "record_id": {
                      "const": 3192247854
                    },
                    "target": {
                      "pattern": "^assets/[^/]+\\.iff/[^/]+\\.scne/(?:block[01]|scene(?:_gpu)?)\\.dat$"
                    },
                    "file": {
                      "pattern": "^assets/.+\\.dat$"
                    }
                  },
                  "not": {
                    "required": [
                      "selection"
                    ]
                  }
                },
                "else": {
                  "if": {
                    "required": [
                      "texture_slot"
                    ]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "component"
                          ]
                        },
                        {
                          "required": [
                            "selection"
                          ]
                        }
                      ]
                    },
                    "properties": {
                      "target": {
                        "pattern": "^assets/[^/]+\\.(?:iff|cdf)/[^/]+\\.(?:txtr|scne)/(?:_support/)?[^/]+\\.dds$"
                      },
                      "file": {
                        "pattern": "^assets/.+\\.dds$"
                      }
                    }
                  },
                  "else": {
                    "not": {
                      "required": [
                        "component"
                      ]
                    },
                    "properties": {
                      "record_type": {
                        "const": 1547079785
                      },
                      "target": {
                        "pattern": "^assets/[^/]+\\.iff/[^/]+\\.txtr/texture\\.dds$"
                      },
                      "file": {
                        "pattern": "^assets/.+\\.dds$"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "texture_slot"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "dds.replace"
                }
              }
            }
          }
        ]
      }
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "roster"
        ]
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "enum": [
                  "1.1.0",
                  "1.2.0",
                  "1.3.0"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "roster"
            ]
          },
          {
            "required": [
              "uniforms"
            ]
          },
          {
            "required": [
              "extensions"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "cloth.positions"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "enum": [
                  "1.1.0",
                  "1.2.0",
                  "1.3.0"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "uniforms"
        ]
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "enum": [
                  "1.2.0",
                  "1.3.0"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "enum": [
                  "1.2.0",
                  "1.3.0"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "extensions": {
            "contains": {
              "properties": {
                "abi": {
                  "const": 2
                }
              },
              "required": [
                "abi"
              ]
            }
          }
        },
        "required": [
          "extensions"
        ]
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "const": "1.3.0"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "court.scene"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "const": "1.3.0"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assets": {
            "contains": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "cloth.simulation"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "requires": {
            "properties": {
              "mod_api": {
                "const": "1.3.0"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "label": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\x00-\\x1f]{1,120}$"
    },
    "version": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  }
}
